    <string name="saturn_auto_hint">Kết nối trước tới đường hầm Cloudflare (Miễn phí), sau đó tới Tor với cầu obfs4 tự động và chọn quốc gia thoát. Chỉ TCP. Kết nối lại sau khi thay đổi.</string>
    <string name="saturn_dns_error">Saturn không thể kết nối đường hầm Cloudflare. Kiểm tra URL đường hầm và IP khởi tạo.</string>
    <string name="saturn_bridges_error">Không có cầu nối obfs4 truy cập được. Thử quét sâu hoặc cầu nối tùy chỉnh.</string>
    <string name="saturn_bootstrap_error">Không thể hoàn tất kết nối Tor. Thử quốc gia tự động, quét sâu hoặc cầu nối tùy chỉnh.</string>
    <string name="saturn_core_exit">Lõi Saturn dừng khi khởi động Tor (mã thoát %1$d).</string>
    <string name="saturn_native_error">Không thể chạy lõi Saturn gốc. Kiểm tra nhật ký ứng dụng.</string>
